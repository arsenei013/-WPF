<Window x:Class="Технология_WPF.ChildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Документ" Height="350" Width="550" WindowStartupLocation="CenterScreen">
    <Grid>
        <TextBox x:Name="MemoBox"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontSize="14"
                 Padding="5"/>
    </Grid>
</Window>

